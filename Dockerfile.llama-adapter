# Thin adapter layer over the pinned upstream llama.cpp server image.
#
# Adds python3 + the agent_config.json -> models-preset generator + an
# entrypoint that regenerates the preset on every boot from
# agent_config.json (the single source of truth). The pinned digest stays
# the base, so the soak-tested build underneath is byte-identical; we only
# bolt the adapter on top.
#
# Build:  docker build -f Dockerfile.llama-adapter -t agent_server-llama-adapter:1.0 .
# (or via docker-compose.adapter.yml, which builds it for you.)
#
# NOTE: when bumping the llama.cpp build, change the default digest here AND
# in docker-compose.yml together (see that file's soak-test history before
# bumping). The base is an ARG so a build can be pointed at an
# already-local digest (e.g. for offline/CI validation) without editing the
# committed default:
#   docker build -f Dockerfile.llama-adapter \
#     --build-arg LLAMA_CPP_BASE=ghcr.io/ggml-org/llama.cpp:server-cuda@sha256:<local> .
# Bumped 2026-08-10 to latest server-cuda (~b10342). Rollback: b9967
# sha256:8d1e8ddc42585632d7bd625c2285eba891ed2ed4428e9eda25ca71ce2f6cce27
ARG LLAMA_CPP_BASE=ghcr.io/ggml-org/llama.cpp:server-cuda@sha256:eca4442a8cb7617fadcf0f7b46dceeed5070a88fbbd947d04918a736fbacfc9e
FROM ${LLAMA_CPP_BASE}

# python3 for the adapter generator (pure stdlib; minimal install). The
# base is Ubuntu-based, so apt is available. Kept tiny; no pip deps.
RUN apt-get update \
	&& apt-get install -y --no-install-recommends python3 \
	&& rm -rf /var/lib/apt/lists/*

COPY adapter/llama_cpp_preset.py /adapter/llama_cpp_preset.py
COPY adapter/entrypoint.sh /adapter/entrypoint.sh
RUN chmod +x /adapter/entrypoint.sh

# Replace the upstream entrypoint with the adapter; it regenerates the
# preset then exec's the real llama-server with the compose-provided args.
ENTRYPOINT ["/adapter/entrypoint.sh"]
