{
  "name": "jobunter_offer_parser",
  "system_prompt": "/agent_server/app/data/prompts/jobunter_offer_parser_system_prompt.txt",
  "params_override": {
    "max_tokens": 500,
    "temperature": 0.1,
    "top_p": 0.9,
    "top_k": 20,
    "min_p": 0.005,
    "chat_template_kwargs": {
      "enable_thinking": false
    },
    "response_format": {
      "type": "json_schema",
      "json_schema": {
        "name": "offer_verdict",
        "schema": {
          "type": "object",
          "properties": {
            "relevant": {
              "type": "boolean"
            },
            "score": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "company": {
              "type": "string"
            },
            "location": {
              "type": "string"
            },
            "work_mode": {
              "type": "string"
            },
            "seniority": {
              "type": "string"
            },
            "contract_type": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "rationale": {
              "type": "string"
            }
          },
          "required": [
            "relevant",
            "score",
            "company",
            "location",
            "work_mode",
            "seniority",
            "contract_type",
            "summary",
            "rationale"
          ]
        }
      }
    }
  },
  "memory_policy": "none"
}
